    "firebase:push-env": "node scripts/push-firebase-env-to-vercel.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "worker:scenario": "tsx workers/scenario-worker.ts",
    "worker:cf-deploy": "cd workers/cloudflare && npm install && npx wrangler deploy",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
