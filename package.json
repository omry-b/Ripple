    "mapbox-gl": "^3.23.1",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "topojson-client": "^3.1.0",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
