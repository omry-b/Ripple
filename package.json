    "@vitest/coverage-v8": "^4.1.6",
    "chromatic": "^16.10.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.4.0",
