{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "ingest": "curl -s -X POST http://localhost:3000/api/ingest/run | jq",
    "db:refresh-live": "tsx scripts/refresh-live.ts",
    "prod:ops": "bash scripts/prod-ops.local.sh",
    "firebase:setup": "bash scripts/setup-firebase.sh",
