# ─── Data layer ───────────────────────────────────────────────
# Omit DATABASE_URL to use in-memory mock data (default for local/Vercel demo).
# Production: DigitalOcean Managed Postgres (see docs/DIGITALOCEAN_POSTGRES.md)
DATABASE_URL=postgresql://user:password@localhost:5432/ripple

# ─── Service auth (Vercel cron + Cloudflare Worker + internal ingest) ─
CRON_SECRET=generate-a-random-secret
# Optional alias for edge-only callers:
INGEST_INTERNAL_SECRET=

# ─── Edge / workers (set on Cloudflare Worker, not Vercel) ───
# APP_URL=https://your-app.vercel.app

# ─── Auth (Clerk + Google) ───────────────────────────────────
# In Clerk Dashboard: Social connections → enable Google only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEMO_USER_ID=user_demo
DEMO_ORG_ID=org_demo
DEMO_USER_EMAIL=analyst@ripple.demo
DEMO_USER_ROLE=analyst
REQUIRE_AUTH_FOR_UI=false
REQUIRE_AUTH_FOR_MUTATIONS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Ingest adapters (placeholders until wired) ───────────────
AIS_API_KEY=
PORTS_API_KEY=
GDELT_API_KEY=
NOAA_API_KEY=
FINANCIAL_DATA_API_KEY=

# ─── Notifications (placeholders) ───────────────────────────
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM=Ripple <onboarding@resend.dev>
PAGERDUTY_ROUTING_KEY=
DIGEST_EMAIL_TO=analyst@ripple.demo
DEFAULT_ORG_ID=org_demo
WEBHOOK_SIGNING_SECRET=generate-a-random-secret

# ─── Map (optional) ─────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Cache (optional) ───────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
